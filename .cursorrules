│   │       ├── sound.ts        # Synthesized audio feedback engine
│   │       └── integrations.service.ts # Connectors API
│   └── package.json
│
├── server/                     # Backend API Service (Node.js + Express + Prisma ORM)
│   ├── prisma/                 # Database Schema & Migrations
│   │   ├── schema.prisma       # PostgreSQL Database Schema (Primary)
│   │   ├── schema.sqlite.prisma# SQLite Schema (Development fallback)
│   │   └── migrations/         # Database Migration History (Prisma)
│   ├── src/
