│   │   │   ├── contracts/      # Digital Contracts & Signatures
│   │   │   ├── inventory/      # Products, Stock, UnoPIM Webhooks
│   │   │   ├── tasks/          # Sprints, Tasks, Agile Kanban
│   │   │   ├── integrations/   # Connectors (Odoo, Sage 1, Sage 50, Sage 200, Shopify, WC, n8n, Stripe, Zapier, GCal)
│   │   │   ├── omnichannel/    # WhatsApp Cloud, Chats, Conversations
│   │   │   ├── notifications/  # Notification center & push alerts
│   │   │   └── audit/          # Security Audit Trail Logging
│   │   ├── services/           # Shared backend services (WebSockets, Cron, Emails)
