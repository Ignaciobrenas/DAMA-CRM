# ==============================================================================
# DAMA-CRM - Zero-Cost Modular CRM Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node Environment & Ports
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
CLIENT_PORT=5173

# ------------------------------------------------------------------------------
# 2. Security & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_crm_dama_change_me_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# Para Docker Compose:
DATABASE_URL=postgresql://crm_user:crm_password@crm-db:5432/dama_crm?schema=public
# Para desarrollo local sin Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dama_crm?schema=public

# Credenciales de base de datos para docker-compose.yml:
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=dama_crm

# ------------------------------------------------------------------------------
# 4. Redis & BullMQ (Background queues)
# ------------------------------------------------------------------------------
REDIS_HOST=crm-redis
REDIS_PORT=6379
# Para desarrollo local sin Docker:
# REDIS_HOST=localhost

# ------------------------------------------------------------------------------
# 5. SMTP & 2FA Configuration (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@tudominio.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM="DAMA-CRM <no-reply@tudominio.com>"

# ------------------------------------------------------------------------------
# 6. Third-Party Integrations Hub / Integraciones de Terceros (100% Funcionales)
# ------------------------------------------------------------------------------

# --- Odoo ERP & CRM (XML-RPC / JSON-RPC) ---
ODOO_URL=https://mi-empresa.odoo.com
ODOO_DB=odoo_db_name
ODOO_USERNAME=admin@mi-empresa.com
ODOO_API_KEY=tu_odoo_api_key_o_password

# --- WooCommerce (WordPress REST API v3 + Webhooks) ---
WOOCOMMERCE_STORE_URL=https://mitienda.com
WOOCOMMERCE_CONSUMER_KEY=tu_woocommerce_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=tu_woocommerce_consumer_secret
WOOCOMMERCE_WEBHOOK_SECRET=tu_woocommerce_webhook_secret

# --- Shopify Store (Admin API + Webhooks HMAC SHA-256) ---
SHOPIFY_SHOP_DOMAIN=mi-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=tu_shopify_access_token
SHOPIFY_API_SECRET_KEY=tu_shopify_api_secret_key
SHOPIFY_WEBHOOK_SECRET=tu_shopify_webhook_secret

# --- n8n Workflow Automation (Bidirectional Webhook & Action Runner) ---
N8N_WEBHOOK_URL=https://n8n.mi-servidor.com/webhook/crm-trigger
N8N_API_KEY=tu_n8n_api_key_secreta

# --- Stripe Payments (Checkout Sessions & Webhook Handlers) ---
STRIPE_PUBLISHABLE_KEY=tu_stripe_publishable_key
STRIPE_SECRET_KEY=tu_stripe_secret_key
STRIPE_WEBHOOK_SECRET=tu_stripe_webhook_secret

# --- Zapier Webhooks (Catch Hook Inbound & Triggers) ---
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/sample/sample/
ZAPIER_API_KEY=tu_zapier_api_key_opcional

# --- Google Calendar (OAuth2 / Agenda CRM) ---
GOOGLE_CALENDAR_EMAIL=agenda@tudominio.com
GOOGLE_CALENDAR_CLIENT_ID=tu_google_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=tu_google_client_secret

# --- UnoPIM (Catálogo & PIM Webhook) ---
UNOPIM_WEBHOOK_SECRET=unopim_secret_token_123

# --- Meta WhatsApp Cloud API (Bandeja Omnicanal) ---
WHATSAPP_WEBHOOK_VERIFY_TOKEN=meta_verify_token_crm_456
WHATSAPP_ACCESS_TOKEN=tu_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=tu_whatsapp_phone_number_id

# ------------------------------------------------------------------------------
# 7. Traefik & Domain (Para producción con Cloudflare Tunnels o Oracle Cloud)
# ------------------------------------------------------------------------------
DOMAIN_NAME=crm.tudominio.com
ACME_EMAIL=admin@tudominio.com
