}

dama.com:53 {
    template IN A {
        match (.*)\.dama\.com
        answer "{{ .Name }} 60 IN A 127.0.0.1"
        fallthrough
    }
    hosts {
        127.0.0.1 dama.com
        127.0.0.1 god.dama.com
        127.0.0.1 app.dama.com
        127.0.0.1 ignacio-corp.dama.com
        fallthrough
    }
    log
    errors
}
