# ==============================================================================
# DAMA-CRM - Archivo de Variables de Entorno (Local Development & Docker Ready)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Entorno de Node.js y Puertos
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_PORT=3000

# ------------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL 15+
# ------------------------------------------------------------------------------
# Conexión para desarrollo local directo:
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/dama_crm?schema=public

# Conexión para Docker Compose (descomentar si ejecutas todo en contenedores):
# DATABASE_URL=postgresql://crm_user:crm_password@crm-db:5432/dama_crm?schema=public

# Credenciales de inicialización para el contenedor PostgreSQL (docker-compose.yml)
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=dama_crm

# ------------------------------------------------------------------------------
# 3. Redis & Colas de Fondo (BullMQ)
# ------------------------------------------------------------------------------
# Para desarrollo local directo:
REDIS_HOST=localhost
REDIS_PORT=6379

# Para despliegue con Docker Compose (descomentar si ejecutas en Docker):
# REDIS_HOST=crm-redis

# ------------------------------------------------------------------------------
# 4. Seguridad, Criptografía & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_crm_dama_change_me_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. Servidor de Correo SMTP & 2FA (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@tudominio.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM="DAMA-CRM <no-reply@tudominio.com>"

# ------------------------------------------------------------------------------
# 6. Integraciones de Terceros (100% Funcionales)
# ------------------------------------------------------------------------------

# --- Odoo ERP & CRM (XML-RPC / JSON-RPC) ---
ODOO_URL=https://odoo.example.com
ODOO_DB=odoo_db
ODOO_USERNAME=admin@example.com
ODOO_API_KEY=

# --- WooCommerce (WordPress REST API v3 + Webhooks) ---
WOOCOMMERCE_STORE_URL=https://tienda.example.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=

# --- Shopify Store (Admin API + Webhooks HMAC SHA-256) ---
SHOPIFY_SHOP_DOMAIN=mi-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_SECRET_KEY=
SHOPIFY_WEBHOOK_SECRET=

# --- n8n Workflow Automation (Bidirectional Webhook & Action Runner) ---
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/crm-trigger
N8N_API_KEY=

# --- Stripe Payments (Checkout Sessions & Webhook Handlers) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Zapier Webhooks (Catch Hook Inbound & Triggers) ---
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/sample/sample/
ZAPIER_API_KEY=

# --- Google Calendar (OAuth2 / Agenda CRM) ---
GOOGLE_CALENDAR_EMAIL=agenda@example.com
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- UnoPIM (Catálogo & PIM Webhook) ---
UNOPIM_WEBHOOK_SECRET=unopim_secret_token_123

# --- Meta WhatsApp Cloud API (Bandeja Omnicanal) ---
WHATSAPP_WEBHOOK_VERIFY_TOKEN=meta_verify_token_crm_456
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------------------------------------------
# 7. Gateway Ingress Traefik & Let's Encrypt (SSL Producción)
# ------------------------------------------------------------------------------
DOMAIN_NAME=crm.local
ACME_EMAIL=admin@dama-crm.local
