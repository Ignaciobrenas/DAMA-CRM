# ==============================================================================
# DAMA-CRM - Archivo de Variables de Entorno (Local Development & Docker Ready)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Entorno de Node.js y Puertos
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_PORT=3000

# ------------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL 15+
# ------------------------------------------------------------------------------
# Conexión para desarrollo local directo:
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/dama_crm?schema=public

# Conexión para Docker Compose (descomentar si ejecutas todo en contenedores):
# DATABASE_URL=postgresql://crm_user:crm_password@crm-db:5432/dama_crm?schema=public

# Credenciales de inicialización para el contenedor PostgreSQL (docker-compose.yml)
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=dama_crm

# ------------------------------------------------------------------------------
# 3. Redis & Colas de Fondo (BullMQ)
# ------------------------------------------------------------------------------
# Para desarrollo local directo:
REDIS_HOST=localhost
REDIS_PORT=6379

# Para despliegue con Docker Compose (descomentar si ejecutas en Docker):
# REDIS_HOST=crm-redis

# ------------------------------------------------------------------------------
# 4. Seguridad, Criptografía & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_crm_dama_change_me_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. Servidor de Correo SMTP & 2FA (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@tudominio.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM="DAMA-CRM <no-reply@tudominio.com>"

# ------------------------------------------------------------------------------
# 6. Integraciones de Terceros (UnoPIM & Meta WhatsApp Cloud API)
# ------------------------------------------------------------------------------
# Secreto compartido para validar webhooks entrantes de UnoPIM:
UNOPIM_WEBHOOK_SECRET=unopim_secret_token_123

# Token de verificación para el handshake de webhooks de Meta WhatsApp:
WHATSAPP_WEBHOOK_VERIFY_TOKEN=meta_verify_token_crm_456

# ------------------------------------------------------------------------------
# 7. Gateway Ingress Traefik & Let's Encrypt (SSL Producción)
# ------------------------------------------------------------------------------
DOMAIN_NAME=crm.local
ACME_EMAIL=admin@dama-crm.local
