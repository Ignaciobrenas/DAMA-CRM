generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Multi-Tenant SaaS Architecture & God Mode
// -----------------------------------------------------------------------------

model Tenant {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  domain      String?  @unique
  isGodTenant Boolean  @default(false)
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  plan        String   @default("ENTERPRISE") // STARTER, PRO, ENTERPRISE
  maxUsers    Int      @default(50)
  branding    String?  @default("{}") // JSON string with custom primaryColor, logo, companyName
  settings    String?  @default("{}") // JSON string with active modules and config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tenants")
}

// -----------------------------------------------------------------------------
// Core: Users, Roles, Dynamic RBAC & Authentication
// -----------------------------------------------------------------------------

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String
  name             String
  avatar           String?
  roleId           String
  role             Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  twoFactorSecret  String?
  twoFactorEnabled Boolean          @default(false)
  preferences      String?          @default("{}")
  isActive         Boolean          @default(true)
  tenantId         String?          @default("master")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignedTasks    Task[]           @relation("TaskAssignee")
  assignedTickets  Ticket[]         @relation("TicketAssignee")
  notifications    Notification[]
  employee         Employee?
  auditLogs        AuditLog[]
  twoFactorTokens  TwoFactorToken[]
  taskComments     TaskComment[]
  taskWorkLogs     TaskWorkLog[]
  projectMembers   ProjectMember[]
  calendarEvents   CalendarEvent[]
  calendarReminders CalendarReminder[]
  calendarIntegrations CalendarIntegration[]
  assignedBoardTasks BoardTask[] @relation("BoardTaskAssignee")
  supervisedBoardTasks BoardTask[] @relation("BoardTaskSupervisor")
  plannerRemindersCreated PlannerReminder[] @relation("plannerRemindersCreated")
  plannerRemindersAssigned PlannerReminder[] @relation("plannerRemindersAssigned")
  userNotes               UserNote[]
  pushSubscriptions       PushSubscription[]
  taskTemplatesCreated    TaskTemplate[] @relation("templatesCreated")
  taskLinksCreated        TaskLink[] @relation("taskLinksCreated")
  githubAccounts          GithubAccount[]
  forgejoAccounts         ForgejoAccount[]
  boardTaskActivities     BoardTaskActivity[]
  boardTaskComments       BoardTaskComment[]
  boardTaskWatchers       BoardTaskWatcher[]
  boardTaskAssignees      BoardTaskAssignee[]
  boardMemberships        BoardMember[]
  changelogReleases       ChangelogRelease[]

  @@index([tenantId, isActive])
  @@index([email])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource  String   // e.g. "companies", "contacts", "deals", "invoices", "projects", "inventory", "workflows", "tickets", "expenses", "tenants"
  action    String   // e.g. "create", "read", "update", "delete", "manage"
  createdAt DateTime @default(now())

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model TwoFactorToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("two_factor_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "CREATE", "UPDATE", "DELETE", "LOGIN", "2FA_VERIFY", "SWITCH_TENANT"
  entity    String   // e.g. "Contact", "Deal", "Invoice", "Tenant", "Ticket", "Expense"
  entityId  String?
  details   String?  // JSON string
  ipAddress String?
  tenantId  String?  @default("master")
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Core: Company & Contact Directory
// -----------------------------------------------------------------------------

model Company {
  id             String    @id @default(uuid())
  name           String
  industry       String?
  website        String?
  phone          String?
  email          String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  annualRevenue  Float?
  employeesCount Int?
  notes          String?
  tenantId       String?   @default("master")
  contacts       Contact[]
  deals          Deal[]
  quotes         Quote[]
  invoices       Invoice[]
  tickets        Ticket[]
  recurringInvoices RecurringInvoice[]
  contracts      Contract[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("companies")
}

model Contact {
  id           String        @id @default(uuid())
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  firstName    String
  lastName     String
  email        String        @unique
  phone        String?
  mobile       String?
  position     String?
  department   String?
  isLead       Boolean       @default(false)
  notes        String?
  tenantId     String?       @default("master")
  deals        Deal[]
  quotes       Quote[]
  invoices     Invoice[]
  tickets      Ticket[]
  recurringInvoices RecurringInvoice[]
  contracts    Contract[]
  omniMessages OmniMessage[]
  calendarEvents CalendarEvent[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("contacts")
}

// -----------------------------------------------------------------------------
// Sales Module: Pipeline & Deals
// -----------------------------------------------------------------------------

model DealStage {
  id          String   @id @default(uuid())
  name        String
  order       Int      @default(0)
  color       String   @default("#2563EB")
  probability Int      @default(50) // Percentage 0 - 100
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("deal_stages")
}

model Deal {
  id                String    @id @default(uuid())
  title             String
  value             Float     @default(0.0)
  currency          String    @default("EUR")
  stageId           String
  stage             DealStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contactId         String?
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  expectedCloseDate DateTime?
  status            String    @default("OPEN") // OPEN, WON, LOST
  notes             String?
  tenantId          String?   @default("master")
  projects          Project[]
  calendarEvents    CalendarEvent[]
  shipments         Shipment[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("deals")
}

// -----------------------------------------------------------------------------
// Agile Planner Module: Projects, Sprints & Tasks
// -----------------------------------------------------------------------------

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  status      String          @default("ACTIVE") // PLANNING, ACTIVE, COMPLETED, ON_HOLD
  priority    String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dealId      String?
  deal        Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  tenantId    String?         @default("master")
  sprints     Sprint[]
  tasks       Task[]
  members     ProjectMember[]
  calendarEvents CalendarEvent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // LEAD, MEMBER, VIEWER
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_members")
}

model Sprint {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  tasks     Task[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("sprints")
}

model Task {
  id             String        @id @default(uuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId       String?
  sprint         Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  status         String        @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  priority       String        @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  storyPoints    Int?          @default(1)
  estimatedHours Float?        @default(0)
  loggedHours    Float?        @default(0)
  assigneeId     String?
  assignee       User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  comments       TaskComment[]
  workLogs       TaskWorkLog[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  content   String   // Markdown support
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskWorkLog {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?
  hours       Float    @default(0.0)
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([taskId, date])
  @@map("task_work_logs")
}

// -----------------------------------------------------------------------------
// Billing & PYME Value Suite: Quotes, Invoices, Signatures & Expenses
// -----------------------------------------------------------------------------

model Quote {
  id              String        @id @default(uuid())
  quoteNumber     String        @unique
  contactId       String?
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  issueDate       DateTime      @default(now())
  expiryDate      DateTime?
  status          String        @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  subtotal        Float         @default(0.0)
  discountPercent Float         @default(0.0)
  discountAmount  Float         @default(0.0)
  taxRate         Float         @default(21.0)
  taxAmount       Float         @default(0.0)
  irpfRate        Float         @default(0.0)
  irpfAmount      Float         @default(0.0)
  total           Float         @default(0.0)
  currency        String        @default("EUR")
  paymentTerms    String        @default("IMMEDIATE") // IMMEDIATE, DAYS_15, DAYS_30, DAYS_60, END_OF_MONTH
  notes           String?
  signatureData   String?       // Base64 PNG signature from digital acceptance canvas
  signedAt        DateTime?
  signedBy        String?       // Signer's full name or email
  publicToken     String?       @unique // Unique secure token for customer self-service portal / quote view
  tenantId        String?       @default("master")
  items           InvoiceItem[]
  invoices        Invoice[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("quotes")
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  quoteId            String?
  quote              Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  contactId          String?
  contact            Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId          String?
  company            Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  issueDate          DateTime      @default(now())
  dueDate            DateTime?
  status             String        @default("DRAFT") // DRAFT, SENT, PAID, PARTIAL, OVERDUE, CANCELLED
  subtotal           Float         @default(0.0)
  discountPercent    Float         @default(0.0)
  discountAmount     Float         @default(0.0)
  taxRate            Float         @default(21.0)
  taxAmount          Float         @default(0.0)
  irpfRate           Float         @default(0.0)
  irpfAmount         Float         @default(0.0)
  total              Float         @default(0.0)
  paidAmount         Float         @default(0.0) // For partial payment / dunning tracking
  currency           String        @default("EUR")
  paymentTerms       String        @default("IMMEDIATE") // IMMEDIATE, DAYS_15, DAYS_30, DAYS_60, END_OF_MONTH
  isRectifying       Boolean       @default(false)
  rectifiesInvoiceId String?
  rectifyingReason   String?
  proforma           Boolean       @default(false)
  notes              String?
  paidAt             DateTime?
  tenantId           String?       @default("master")
  items              InvoiceItem[]
  shipments          Shipment[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quoteId     String?
  quote       Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1.0)
  unitPrice   Float    @default(0.0)
  discount    Float    @default(0.0) // Line-item discount percent
  amount      Float    @default(0.0)

  @@map("invoice_items")
}

model TenantInvitation {
  id          String    @id @default(uuid())
  token       String    @unique
  email       String
  tenantSlug  String?
  companyName String?
  role        String    @default("ADMIN")
  status      String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  expiresAt   DateTime
  metadata    String?   @default("{}") // JSON config
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("tenant_invitations")
}

model RecurringInvoice {
  id            String                 @id @default(uuid())
  title         String
  frequency     String                 @default("MONTHLY") // WEEKLY, MONTHLY, QUARTERLY, BIANNUAL, YEARLY
  status        String                 @default("ACTIVE")  // ACTIVE, PAUSED, CANCELLED
  startDate     DateTime               @default(now())
  nextIssueDate DateTime
  endDate       DateTime?
  lastIssuedAt  DateTime?
  subtotal      Float                  @default(0.0)
  taxRate       Float                  @default(21.0)
  taxAmount     Float                  @default(0.0)
  total         Float                  @default(0.0)
  currency      String                 @default("EUR")
  notes         String?
  autoSendEmail Boolean                @default(true)
  tenantId      String?                @default("master")
  companyId     String?
  company       Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items         RecurringInvoiceItem[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@map("recurring_invoices")
}

model RecurringInvoiceItem {
  id                 String           @id @default(uuid())
  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  description        String
  quantity           Float            @default(1.0)
  unitPrice          Float            @default(0.0)
  amount             Float            @default(0.0)

  @@map("recurring_invoice_items")
}

model Contract {
  id               String    @id @default(uuid())
  contractNumber   String    @unique
  title            String
  type             String    @default("SERVICE") // SERVICE, SLA, NDA, LICENSE, EMPLOYMENT, PARTNERSHIP
  status           String    @default("ACTIVE")  // DRAFT, PENDING_SIGNATURE, ACTIVE, EXPIRED, TERMINATED
  startDate        DateTime  @default(now())
  endDate          DateTime?
  value            Float?    @default(0.0)
  currency         String    @default("EUR")
  autoRenew        Boolean   @default(false)
  noticePeriodDays Int       @default(30)
  terms            String?
  signedAt         DateTime?
  signerName       String?
  signatureData    String?
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId        String?
  contact          Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  tenantId         String?   @default("master")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("contracts")
}

model Expense {
  id            String    @id @default(uuid())
  expenseNumber String    @unique // e.g. EXP-2026-0001
  supplierName  String
  supplierTaxId String?
  category      String    @default("OPERATIONAL") // OPERATIONAL, SOFTWARE, MARKETING, TRAVEL, OFFICE, UTILITIES, LEGAL, OTHER
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  subtotal      Float     @default(0.0)
  taxRate       Float     @default(21.0)
  taxAmount     Float     @default(0.0)
  total         Float     @default(0.0)
  status        String    @default("PAID") // PENDING, PAID, CANCELLED
  paymentMethod String?   @default("BANK_TRANSFER") // BANK_TRANSFER, CREDIT_CARD, DIRECT_DEBIT, CASH
  notes         String?
  receiptUrl    String?
  tenantId      String?   @default("master")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("expenses")
}

// -----------------------------------------------------------------------------
// Helpdesk & Support Tickets Module
// -----------------------------------------------------------------------------

model Ticket {
  id              String          @id @default(uuid())
  ticketNumber    String          @unique // e.g. TCK-2026-0001
  title           String
  description     String
  status          String          @default("OPEN") // OPEN, IN_PROGRESS, WAITING_CUSTOMER, RESOLVED, CLOSED
  priority        String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  category        String          @default("GENERAL") // TECHNICAL, BILLING, SALES, GENERAL
  channel         String          @default("PORTAL") // PORTAL, EMAIL, WHATSAPP, PHONE, INTERNAL
  contactId       String?
  contact         Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedToId    String?
  assignedTo      User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  tenantId        String?         @default("master")
  messages        TicketMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("tickets")
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType  String   // AGENT, CUSTOMER, SYSTEM
  senderId    String?
  senderName  String
  message     String
  isInternal  Boolean  @default(false) // Yellow confidential internal note for agents
  attachments String?  // JSON array of URLs
  createdAt   DateTime @default(now())

  @@map("ticket_messages")
}

// -----------------------------------------------------------------------------
// Inventory Module: Products, Stock Movements & UnoPIM Catalog Integration
// -----------------------------------------------------------------------------

model Product {
  id             String          @id @default(uuid())
  externalId     String?         @unique // UnoPIM ID for bidirectional sync
  sku            String          @unique
  name           String
  description    String?
  price          Float           @default(0.0)
  costPrice      Float?          @default(0.0)
  stock          Int             @default(0)
  minStock       Int             @default(5)
  maxStock       Int?
  unit           String          @default("UNIT") // UNIT, KG, METER, LITER, PACK, HOUR, SERVICE
  category       String?
  barcode        String?
  imageUrl       String?
  images         String?         @default("[]") // JSON array of image URLs
  location       String?         // Warehouse shelf/aisle e.g. "Pasillo A - Est. 3"
  supplierName   String?
  supplierSku    String?
  taxRate        Float           @default(21.0)
  weight         Float?
  dimensions     String?         // e.g. "20x15x10 cm"
  brand          String?
  tags           String?
  isActive       Boolean         @default(true)
  notes          String?
  isSync         Boolean         @default(false)
  lastSyncedAt   DateTime?
  tenantId       String?         @default("master")
  attributes     String?         @default("{}") // Mapped multi-app attributes (unopim, opencart, sage, odoo, shopify, woocommerce)
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId, category])
  @@index([tenantId, sku])
  @@map("products")
}

model StockMovement {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          String   // INBOUND, OUTBOUND, ADJUSTMENT, TRANSFER, RETURN
  quantity      Int      // Delta quantity (positive or negative)
  previousStock Int
  newStock      Int
  reason        String?
  reference     String?
  performedBy   String?
  tenantId      String?  @default("master")
  createdAt     DateTime @default(now())

  @@index([productId, createdAt])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

// -----------------------------------------------------------------------------
// Automations Module: Workflows & Trigger Engine
// -----------------------------------------------------------------------------

model Workflow {
  id             String        @id @default(uuid())
  name           String
  description    String?
  trigger        String        // e.g. "deal.stage_changed", "contact.created", "invoice.paid"
  triggerConfig  String?       // JSON config
  action         String        // e.g. "send_email", "create_task", "notify_webhook"
  actionConfig   String?       // JSON config
  isActive       Boolean       @default(true)
  executionCount Int           @default(0)
  lastExecutedAt DateTime?
  tenantId       String?       @default("master")
  logs           WorkflowLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("workflows")
}

model WorkflowLog {
  id           String   @id @default(uuid())
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status       String   // SUCCESS, FAILED
  triggerData  String?  // JSON string
  resultData   String?  // JSON string
  errorMessage String?
  executedAt   DateTime @default(now())

  @@map("workflow_logs")
}

// -----------------------------------------------------------------------------
// Omnichannel Module: WhatsApp / Email Inbox & Customer Timeline
// -----------------------------------------------------------------------------

model OmniMessage {
  id         String   @id @default(uuid())
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel    String   // WHATSAPP, EMAIL, SMS, WEB_CHAT
  direction  String   // INBOUND, OUTBOUND
  sender     String
  recipient  String
  subject    String?
  content    String
  rawPayload String?  // JSON string
  timestamp  DateTime @default(now())
  isRead     Boolean  @default(false)
  tenantId   String?  @default("master")

  @@map("omni_messages")
}

// -----------------------------------------------------------------------------
// Activities Module: Calls, Meetings, Notes & Interactions
// -----------------------------------------------------------------------------

model Activity {
  id              String    @id @default(uuid())
  type            String    // CALL, MEETING, NOTE, EMAIL, TASK
  subject         String
  description     String?
  durationMinutes Int?      @default(15)
  outcome         String?
  scheduledAt     DateTime?
  completedAt     DateTime?
  contactId       String?
  dealId          String?
  userId          String?
  tenantId        String?   @default("master")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("activities")
}

// -----------------------------------------------------------------------------
// Custom Fields Engine: Dynamic Metadata for Companies, Contacts & Deals
// -----------------------------------------------------------------------------

model CustomField {
  id           String             @id @default(uuid())
  entityType   String             // COMPANY, CONTACT, DEAL
  name         String             // Unique key, e.g. "renewal_date"
  label        String             // Display label, e.g. "Fecha de Renovación"
  fieldType    String             // TEXT, NUMBER, DATE, SELECT, BOOLEAN
  optionsJson  String?            // JSON options for SELECT
  isRequired   Boolean            @default(false)
  defaultValue String?
  tenantId     String?            @default("master")
  values       CustomFieldValue[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([entityType, name])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  entityId      String      // Target Company, Contact or Deal ID
  value         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([customFieldId, entityId])
  @@map("custom_field_values")
}

// -----------------------------------------------------------------------------
// Real-Time Notification Engine & Global App Alerts
// -----------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?   @default("master")
  title     String
  message   String
  type      String    @default("info") // ticket, invoice, quote, deal, stock, lead, system, workflow, chat
  priority  String    @default("normal") // low, normal, high, urgent
  actionUrl String?   // Redirect route e.g. /tickets, /invoicing, /inventory, /pipeline
  metadata  String?   // JSON payload
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, read, createdAt])
  @@index([userId, read, createdAt])
  @@index([type])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// Human Resources & Attendance: Employees, Payrolls (Nóminas) & Time Records
// -----------------------------------------------------------------------------

model Employee {
  id             String          @id @default(uuid())
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId       String?         @default("master")
  firstName      String
  lastName       String
  email          String
  phone          String?
  jobTitle       String?
  department     String?         // SALES, ENGINEERING, HR, FINANCE, OPERATIONS, SUPPORT
  hireDate       DateTime?       @default(now())
  contractType   String?         @default("INDEFINIDO") // INDEFINIDO, TEMPORAL, PRACTICAS, AUTONOMO
  baseSalary     Float           @default(0.0)
  iban           String?
  status         String          @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  odooEmployeeId Int?            // Linked Odoo HR Employee ID
  payrolls       Payroll[]
  timeRecords    TimeRecord[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([email])
  @@map("employees")
}

model Payroll {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId    String?   @default("master")
  month       Int       // 1 - 12
  year        Int       // e.g. 2026
  baseSalary  Float     @default(0.0)
  bonuses     Float     @default(0.0)
  deductions  Float     @default(0.0)
  netSalary   Float     @default(0.0)
  status      String    @default("DRAFT") // DRAFT, ISSUED, PAID
  paidAt      DateTime?
  pdfUrl      String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, month, year])
  @@index([tenantId, year, month])
  @@map("payrolls")
}

model TimeRecord {
  id               String    @id @default(uuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId           String?
  tenantId         String?   @default("master")
  clockIn          DateTime  @default(now())
  clockOut         DateTime?
  durationMinutes  Int?      @default(0)
  type             String    @default("WORK") // WORK, BREAK, REMOTE, TRAVEL, MEDICAL
  reason           String?   // Justificación e.g. "Oficina Central", "Teletrabajo", "Visita comercial", "Pausa médica"
  notes            String?
  ipAddress        String?
  location         String?
  odooAttendanceId Int?      // Linked Odoo attendance record ID
  status           String    @default("VALID") // VALID, PENDING_APPROVAL, REJECTED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, clockIn])
  @@index([employeeId, clockIn])
  @@map("time_records")
}

// -----------------------------------------------------------------------------
// Calendar Module: Personal & Company Calendars, Events, Alerts & Sync
// -----------------------------------------------------------------------------

model CalendarEvent {
  id               String             @id @default(uuid())
  tenantId         String?            @default("master")
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime
  allDay           Boolean            @default(false)
  location         String?
  color            String?            @default("#3B82F6")
  type             String             @default("EVENT") // EVENT, MEETING, DEADLINE, MILESTONE, REMINDER, CALL, TIME_BLOCK
  isCompanyWide    Boolean            @default(false)
  status           String             @default("CONFIRMED") // CONFIRMED, TENTATIVE, CANCELLED
  projectId        String?
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId           String?
  task             Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  dealId           String?
  deal             Deal?              @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contactId        String?
  contact          Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  externalSyncId   String?
  externalProvider String?            // GOOGLE, APPLE, ICAL
  recurrence       String?            @default("NONE") // NONE, DAILY, WEEKLY, MONTHLY, YEARLY
  reminders        CalendarReminder[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId, startDate])
  @@index([userId, startDate])
  @@index([projectId])
  @@index([isCompanyWide])
  @@map("calendar_events")
}

model CalendarReminder {
  id            String        @id @default(uuid())
  eventId       String
  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tenantId      String?       @default("master")
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutesBefore Int           @default(15) // 0, 5, 10, 15, 30, 60, 1440
  method        String        @default("NOTIFICATION") // NOTIFICATION, EMAIL, SOUND, ALL
  isDismissed   Boolean       @default(false)
  remindAt      DateTime
  createdAt     DateTime      @default(now())

  @@index([userId, remindAt, isDismissed])
  @@map("calendar_reminders")
}

model CalendarIntegration {
  id          String    @id @default(uuid())
  tenantId    String?   @default("master")
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String    // GOOGLE, APPLE, OUTLOOK
  isEnabled   Boolean   @default(false)
  syncToken   String?   // token or iCal feed secret
  calendarId  String?
  lastSyncAt  DateTime?
  config      String?   @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, provider])
  @@map("calendar_integrations")
}

// -----------------------------------------------------------------------------
// Appointments & Professional Booking Engine (Universal: Advisory, Tech, Health, Services)
// -----------------------------------------------------------------------------

model AppointmentService {
  id          String   @id @default(uuid())
  tenantId    String?  @default("master")
  name        String
  category    String   @default("CONSULTATION") // CONSULTATION, TECHNICAL, ADVISORY, SERVICE, TREATMENT, OTHER
  durationMin Int      @default(30)
  price       Float    @default(0.0)
  supplyCost  Float    @default(0.0)
  description String?
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, category])
  @@map("appointment_services")
}

model Appointment {
  id              String   @id @default(uuid())
  tenantId        String?  @default("master")
  clientName      String
  clientPhone     String?
  clientEmail     String?
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  staffId         String?
  staffName       String   @default("Especialista")
  serviceIds      String?  @default("[]") // JSON Array of service IDs
  servicesDetails String?  @default("[]") // JSON Array of full service item objects
  startTime       DateTime
  endTime         DateTime
  durationMin     Int      @default(30)
  totalPrice      Float    @default(0.0)
  totalSupplyCost Float    @default(0.0)
  estimatedProfit Float    @default(0.0)
  status          String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  paymentStatus   String   @default("PENDING")   // PENDING, PAID, REFUNDED
  paymentMethod   String?  // CASH, CARD, BIZUM, TRANSFER
  notes           String?
  invoiceId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, startTime])
  @@index([tenantId, status])
  @@index([contactId])
  @@map("appointments")
}

// -----------------------------------------------------------------------------
// Logistics & Multi-Carrier Courier Tracking Engine (GLS, NACEX, Amazon, Correos, DHL, SEUR)
// -----------------------------------------------------------------------------

model Shipment {
  id               String               @id @default(uuid())
  tenantId         String?              @default("master")
  trackingNumber   String
  carrier          String               @default("GLS") // GLS, NACEX, AMAZON, CORREOS, DHL, SEUR, FEDEX, UPS
  recipientName    String
  recipientAddress String
  recipientCity    String
  recipientPhone   String?
  recipientEmail   String?
  status           String               @default("PENDING") // PENDING, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, EXCEPTION, RETURNED
  origin           String               @default("Almacén Central")
  destination      String
  estimatedDelivery DateTime?
  actualDelivery   DateTime?
  dealId           String?
  deal             Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  invoiceId        String?
  invoice          Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  weightKg         Float?               @default(1.0)
  notes            String?
  checkpoints      ShipmentCheckpoint[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([tenantId, trackingNumber])
  @@index([tenantId, carrier])
  @@index([tenantId, status])
  @@map("shipments")
}

model ShipmentCheckpoint {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  location    String
  description String
  timestamp   DateTime @default(now())

  @@index([shipmentId, timestamp])
  @@map("shipment_checkpoints")
}

// -----------------------------------------------------------------------------
// Internal Team Chat & Department Channels
// -----------------------------------------------------------------------------

model InternalChatChannel {
  id          String                @id @default(uuid())
  tenantId    String?               @default("master")
  name        String
  type        String                @default("DEPARTMENT") // DEPARTMENT, DIRECT, PROJECT, ANNOUNCEMENT
  description String?
  isPrivate   Boolean               @default(false)
  members     String?               @default("[]") // JSON array of user IDs
  messages    InternalChatMessage[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([tenantId, type])
  @@map("internal_chat_channels")
}

model InternalChatMessage {
  id          String               @id @default(uuid())
  channelId   String
  channel     InternalChatChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tenantId    String?              @default("master")
  senderId    String
  senderName  String
  senderAvatar String?
  text        String
  attachments String?              @default("[]") // JSON Array of attachments
  reactions   String?              @default("{}") // JSON map of emoji -> userIds
  isPinned    Boolean              @default(false)
  replyToId   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([channelId, createdAt])
  @@index([tenantId, senderId])
  @@map("internal_chat_messages")
}

// -----------------------------------------------------------------------------
// Agile Planner & Task Management Models
// -----------------------------------------------------------------------------

model Board {
  id            String               @id @default(uuid())
  key           String?              @unique
  name          String
  description   String?
  color         String               @default("gradient-primary")
  methodology   String               @default("scrum")
  boardType     String               @default("individual") // "individual" | "group"
  parentBoardId String?              // For hierarchical boards
  startDate     DateTime?
  endDate       DateTime?
  archived      Boolean              @default(false)
  budgetedHours Float?
  settings      String?              @default("{}")
  tenantId      String?              @default("master")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  columns       BoardColumn[]
  tasks         BoardTask[]
  sprints       BoardSprint[]
  members       BoardMember[]
  githubRepos   GithubRepository[]
  forgejoRepos  ForgejoRepository[]
  parentBoard   Board?               @relation("BoardHierarchy", fields: [parentBoardId], references: [id], onDelete: SetNull)
  childBoards   Board[]              @relation("BoardHierarchy")

  @@index([tenantId])
  @@map("boards")
}

model BoardMember {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([boardId, userId])
  @@map("board_members")
}

model BoardColumn {
  id             String      @id @default(uuid())
  title          String
  status         String?
  position       Int
  wipLimit       Int?
  allowedRoles   String?     @default("[]") // JSON string of allowed roles
  blockedUserIds String?     @default("[]") // JSON array of blocked user IDs
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  boardId        String
  board          Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks          BoardTask[]

  @@unique([boardId, position])
  @@map("board_columns")
}

model BoardSprint {
  id        String      @id @default(uuid())
  boardId   String
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  status    String      @default("planned") // planned, active, completed
  tasks     BoardTask[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("board_sprints")
}

model BoardTask {
  id                   String                 @id @default(uuid())
  key                  String                 @unique
  title                String
  description          String?
  type                 String                 @default("task")
  priority             String                 @default("medium")
  status               String                 @default("todo")
  dueDate              DateTime?
  wasOverdueWhenClosed Boolean?
  githubIssueNumber    Int?
  githubIssueUrl       String?
  forgejoIssueNumber   Int?
  forgejoIssueUrl      String?
  harvestConfig        String?                @default("{}")
  labels               String?                @default("[]")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  boardId              String
  columnId             String?
  assigneeId           String?
  supervisorId         String?
  verified             Boolean                @default(false)
  verifiedAt           DateTime?
  sprintId             String?
  board                Board                  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column               BoardColumn?           @relation(fields: [columnId], references: [id])
  assignee             User?                  @relation("BoardTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  supervisor           User?                  @relation("BoardTaskSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  sprint               BoardSprint?           @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  activities           BoardTaskActivity[]
  attachments          BoardTaskAttachment[]
  comments             BoardTaskComment[]
  assignees            BoardTaskAssignee[]
  watchers             BoardTaskWatcher[]
  pullRequests         BoardTaskPullRequest[]
  branches             BoardTaskBranch[]
  reminders            PlannerReminder[]
  githubBranches       GithubBranch[]
  githubCommits        GithubCommit[]
  githubPRs            GithubPullRequest[]
  forgejoBranches      ForgejoBranch[]
  forgejoCommits       ForgejoCommit[]
  forgejoPRs           ForgejoPullRequest[]
  taskLinksA           TaskLink[]             @relation("taskLinksA")
  taskLinksB           TaskLink[]             @relation("taskLinksB")

  @@index([boardId, columnId])
  @@index([assigneeId])
  @@index([supervisorId])
  @@map("board_tasks")
}

model TaskLink {
  id          String    @id @default(uuid())
  taskAId     String
  taskBId     String
  createdAt   DateTime  @default(now())
  createdById String?
  taskA       BoardTask @relation("taskLinksA", fields: [taskAId], references: [id], onDelete: Cascade)
  taskB       BoardTask @relation("taskLinksB", fields: [taskBId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("taskLinksCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([taskAId, taskBId])
  @@index([taskAId])
  @@index([taskBId])
  @@map("task_links")
}

model BoardTaskAssignee {
  id         String    @id @default(uuid())
  taskId     String
  userId     String
  assignedAt DateTime  @default(now())
  task       BoardTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("board_task_assignees")
}

model BoardTaskWatcher {
  id        String    @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime  @default(now())
  task      BoardTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("board_task_watchers")
}

model BoardTaskActivity {
  id        String     @id @default(uuid())
  type      String
  content   String
  metadata  String?    @default("{}")
  createdAt DateTime   @default(now())
  taskId    String?
  userId    String
  task      BoardTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("board_task_activities")
}

model BoardTaskAttachment {
  id        String            @id @default(uuid())
  filename  String
  url       String
  size      Int
  mimetype  String
  createdAt DateTime          @default(now())
  taskId    String
  commentId String?
  task      BoardTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment   BoardTaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("board_task_attachments")
}

model BoardTaskComment {
  id          String                @id @default(uuid())
  content     String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  taskId      String
  userId      String?
  task        BoardTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  attachments BoardTaskAttachment[]

  @@map("board_task_comments")
}

model BoardTaskPullRequest {
  id        String    @id @default(uuid())
  url       String
  title     String?
  taskId    String
  createdAt DateTime  @default(now())
  task      BoardTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("board_task_pull_requests")
}

model BoardTaskBranch {
  id        String    @id @default(uuid())
  name      String
  url       String?
  taskId    String
  createdAt DateTime  @default(now())
  task      BoardTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("board_task_branches")
}

model GithubAccount {
  id             String             @id @default(uuid())
  username       String
  email          String?
  avatarUrl      String?
  encryptedToken String
  tokenIv        String
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories   GithubRepository[]

  @@unique([username, userId])
  @@map("github_accounts")
}

model GithubRepository {
  id              String              @id @default(uuid())
  name            String
  fullName        String
  url             String
  defaultBranch   String              @default("main")
  isActive        Boolean             @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  boardId         String
  githubAccountId String?
  branches        GithubBranch[]
  commits         GithubCommit[]
  pullRequests    GithubPullRequest[]
  board           Board               @relation(fields: [boardId], references: [id], onDelete: Cascade)
  account         GithubAccount?      @relation(fields: [githubAccountId], references: [id])

  @@unique([boardId, name])
  @@map("github_repositories")
}

model GithubBranch {
  id           String           @id @default(uuid())
  name         String
  sha          String
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  repositoryId String
  taskId       String?
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  task         BoardTask?       @relation(fields: [taskId], references: [id])

  @@unique([repositoryId, name])
  @@map("github_branches")
}

model GithubCommit {
  id           String           @id @default(uuid())
  sha          String
  message      String
  author       String
  url          String
  createdAt    DateTime         @default(now())
  repositoryId String
  taskId       String?
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  task         BoardTask?       @relation(fields: [taskId], references: [id])

  @@unique([repositoryId, sha])
  @@map("github_commits")
}

model GithubPullRequest {
  id           String           @id @default(uuid())
  number       Int
  title        String
  description  String?
  state        String
  url          String
  createdBy    String
  mergedAt     DateTime?
  closedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  repositoryId String
  taskId       String?
  repository   GithubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  task         BoardTask?       @relation(fields: [taskId], references: [id])

  @@unique([repositoryId, number])
  @@map("github_pull_requests")
}

model ForgejoAccount {
  id             String              @id @default(uuid())
  username       String
  email          String?
  avatarUrl      String?
  encryptedToken String
  tokenIv        String
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories   ForgejoRepository[]

  @@unique([username, userId])
  @@map("forgejo_accounts")
}

model ForgejoRepository {
  id            String               @id @default(uuid())
  name          String
  fullName      String
  url           String
  defaultBranch String               @default("main")
  isActive      Boolean              @default(true)
  lastSyncAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  boardId       String
  accountId     String?
  branches      ForgejoBranch[]
  commits       ForgejoCommit[]
  pullRequests  ForgejoPullRequest[]
  board         Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  account       ForgejoAccount?      @relation(fields: [accountId], references: [id])

  @@unique([boardId, name])
  @@map("forgejo_repositories")
}

model ForgejoBranch {
  id           String            @id @default(uuid())
  name         String
  sha          String
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  repositoryId String
  taskId       String?
  repository   ForgejoRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  task         BoardTask?        @relation(fields: [taskId], references: [id])

  @@unique([repositoryId, name])
  @@map("forgejo_branches")
}

model ForgejoCommit {
  id           String            @id @default(uuid())
  sha          String
  message      String
  author       String
  url          String
  createdAt    DateTime          @default(now())
  repositoryId String
  taskId       String?
  repository   ForgejoRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  task         BoardTask?        @relation(fields: [taskId], references: [id])

  @@unique([repositoryId, sha])
  @@map("forgejo_commits")
}

model ForgejoPullRequest {
  id           String            @id @default(uuid())
  number       Int
  title        String
  description  String?
  state        String
  url          String
  createdBy    String
  mergedAt     DateTime?
  closedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  repositoryId String
  taskId       String?
  repository   ForgejoRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  task         BoardTask?        @relation(fields: [taskId], references: [id])

  @@unique([repositoryId, number])
  @@map("forgejo_pull_requests")
}

model PlannerReminder {
  id                String     @id @default(uuid())
  title             String
  description       String?
  scheduledAt       DateTime
  status            String     @default("pending") // pending, notified, confirmed, snoozed, cancelled
  priority          String     @default("medium") // high, medium, low
  recurrenceType    String     @default("none") // none, daily, weekly, monthly
  recurrenceDays    String?    @default("[]") // JSON string
  recurrenceEndDate DateTime?
  snoozedUntil      DateTime?
  lastNotifiedAt    DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdById       String
  assignedToId      String
  relatedTaskId     String?
  createdBy         User       @relation("plannerRemindersCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo        User       @relation("plannerRemindersAssigned", fields: [assignedToId], references: [id], onDelete: Cascade)
  relatedTask       BoardTask? @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)

  @@index([assignedToId])
  @@index([status])
  @@index([scheduledAt])
  @@map("planner_reminders")
}

model UserNote {
  id        String   @id @default(uuid())
  title     String?
  content   String
  color     String?  @default("yellow")
  pinned    Boolean  @default(false)
  order     Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pinned])
  @@map("user_notes")
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model TaskTemplate {
  id           String   @id @default(uuid())
  name         String
  description  String?
  content      String
  scope        String   @default("personal") // "general" | "personal"
  departmentId String?
  memberIds    String?  @default("[]") // JSON array of user IDs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?
  createdBy    User?    @relation("templatesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([scope])
  @@map("task_templates")
}

model ChangelogRelease {
  id          String                  @id @default(uuid())
  version     String
  title       String?
  releasedAt  DateTime                @default(now())
  createdById String?
  createdBy   User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  entries     ChangelogReleaseEntry[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([releasedAt])
  @@map("changelog_releases")
}

model ChangelogReleaseEntry {
  id          String           @id @default(uuid())
  releaseId   String
  category    String           @default("feature") // feature | fix | improvement
  description String
  issueNumber Int?
  issueUrl    String?
  order       Int              @default(0)
  release     ChangelogRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@map("changelog_release_entries")
}

model HarvestReportConfig {
  id           String   @id @default(uuid())
  emails       String   @default("[]") // JSON array of email addresses
  enabled      Boolean  @default(true)
  scheduleTime String   @default("18:00")
  timezone     String   @default("Europe/Madrid")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("harvest_report_configs")
}

model ProjectBudgetAlertConfig {
  id              String   @id @default(uuid())
  emails          String   @default("[]") // JSON array
  enabled         Boolean  @default(true)
  scheduleTime    String   @default("09:00")
  timezone        String   @default("Europe/Madrid")
  alert90Enabled  Boolean  @default(true)
  alert100Enabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("project_budget_alert_configs")
}

model ProjectBudgetAlertStatus {
  id                String    @id @default(uuid())
  boardId           String    @unique
  lastAlertSent90   DateTime?
  lastAlertSent100  DateTime?
  lastDailyReminder DateTime?
  currentStatus     String    @default("under_budget")
  lastPercentage    Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([boardId])
  @@map("project_budget_alert_statuses")
}

model FuelRate {
  id            String   @id @default(uuid())
  ratePerKm     Float
  currency      String   @default("EUR")
  effectiveFrom DateTime @unique
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("fuel_rates")
}

model ExpenseReceipt {
  id           String   @id @default(uuid())
  filename     String
  url          String
  size         Int
  mimetype     String
  expenseId    String
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([expenseId])
  @@map("expense_receipts")
}

model ExpenseReminderConfig {
  id                     String    @id @default(uuid())
  emails                 String    @default("[]") // JSON array
  enabled                Boolean   @default(false)
  frequency              String    @default("weekly")
  dayOfWeek              Int       @default(1)
  dayOfMonth             Int       @default(1)
  scheduleTime           String    @default("09:00")
  timezone               String    @default("Europe/Madrid")
  includePendingApproval Boolean   @default(true)
  includePendingPayment  Boolean   @default(true)
  sendWhenEmpty          Boolean   @default(false)
  lastSentAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("expense_reminder_configs")
}
