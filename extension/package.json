{
  "name": "dama-agile-planner-extension",
  "version": "1.0.0",
  "description": "DAMA Agile Planner companion browser extension (Chrome & Firefox: timer, notifications, pinned notes)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
