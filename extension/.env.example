# --- DAMA Agile Planner extension build-time config ---

# REQUIRED. The self-hosted DAMA-CRM server this build of the extension
# talks to (e.g. http://localhost:4000). Baked in at build time —
# the extension is built once per deployment.
WXT_SERVER_URL=http://localhost:4000

# Optional. Firefox self-distribution signing (used by `npm run sign:firefox`
# via web-ext).
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=
